{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    /* Vite's `?worker` and asset import types. */
    "types": ["vite/client"],

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  /*
   * Self-check scripts run under Node, not the browser bundle, and would
   * otherwise need @types/node pulled into the app's type environment. They
   * are verified by running them (`npm run check`), not by tsc.
   */
  "exclude": ["src/**/*.check.ts"]
}
