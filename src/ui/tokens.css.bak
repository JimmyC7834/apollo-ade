/*
 * The central styling contract. Feature CSS uses --ide-* tokens rather than
 * inventing isolated values, so a semantic role always renders the same way.
 * Values follow VS Code's dark theme.
 */

:root {
	/* Surfaces */
	--ide-bg: #1f1f1f;
	--ide-bg-titlebar: #181818;
	--ide-bg-sidebar: #181818;
	--ide-bg-panel: #181818;
	--ide-bg-overlay: #202020;
	--ide-bg-hover: #2a2d2e;
	--ide-bg-active: #04395e;

	/* Foreground hierarchy */
	--ide-fg: #cccccc;
	--ide-fg-muted: #9d9d9d;
	--ide-fg-subtle: #6e6e6e;
	--ide-fg-danger: #f14c4c;

	/* Borders and focus */
	--ide-border: #2b2b2b;
	--ide-border-strong: #454545;
	--ide-focus: #0078d4;
	--ide-focus-width: 1px;

	/*
	 * Terminal. Values are VS Code's own dark defaults, not approximations:
	 * `terminal.foreground` and the `terminal.ansi*` map from
	 * src/vs/workbench/contrib/terminal/common/terminalColorRegistry.ts,
	 * `terminal.selectionBackground` from `editor.selectionBackground`,
	 * `terminal.tab.activeBorder` from the dark_modern theme, and the font
	 * from DEFAULT_WINDOWS_FONT_FAMILY / defaultTerminalFontSize.
	 * `terminal.background` is unset in VS Code, so it inherits the panel.
	 */
	--ide-terminal-font-family: Consolas, "Courier New", monospace;
	--ide-terminal-font-size: 14px;
	--ide-terminal-fg: #cccccc;
	--ide-terminal-selection: #264f78;
	--ide-terminal-tab-active-border: #0078d4;

	--ide-ansi-black: #000000;
	--ide-ansi-red: #cd3131;
	--ide-ansi-green: #0dbc79;
	--ide-ansi-yellow: #e5e510;
	--ide-ansi-blue: #2472c8;
	--ide-ansi-magenta: #bc3fbc;
	--ide-ansi-cyan: #11a8cd;
	--ide-ansi-white: #e5e5e5;
	--ide-ansi-bright-black: #666666;
	--ide-ansi-bright-red: #f14c4c;
	--ide-ansi-bright-green: #23d18b;
	--ide-ansi-bright-yellow: #f5f543;
	--ide-ansi-bright-blue: #3b8eea;
	--ide-ansi-bright-magenta: #d670d6;
	--ide-ansi-bright-cyan: #29b8db;
	--ide-ansi-bright-white: #e5e5e5;

	/* Scrollbars — VS Code's translucent slider over the scrolled surface. */
	--ide-scrollbar-size: 10px;
	--ide-scrollbar-slider: rgb(121 121 121 / 40%);
	--ide-scrollbar-slider-hover: rgb(100 100 100 / 70%);
	--ide-scrollbar-slider-active: rgb(191 191 191 / 40%);

	/* Inputs — VS Code `input.*` from dark_modern. */
	--ide-input-bg: #313131;
	--ide-input-border: #3c3c3c;
	--ide-input-fg: #cccccc;
	--ide-input-placeholder: #989898;

	/* Spacing */
	--ide-space-1: 2px;
	--ide-space-2: 4px;
	--ide-space-3: 8px;
	--ide-space-4: 12px;
	--ide-space-5: 16px;

	/* Typography */
	--ide-font-family: "Segoe UI", system-ui, sans-serif;
	--ide-font-family-mono: "Cascadia Mono", Consolas, monospace;
	--ide-font-size: 13px;
	--ide-font-size-small: 11px;
	--ide-line-height: 22px;

	/* Radii */
	--ide-radius: 4px;

	/* Pane and control dimensions */
	--ide-titlebar-height: 35px;
	--ide-pane-header-height: 35px;
	--ide-row-height: 22px;
	--ide-control-size: 24px;
	--ide-sash-size: 4px;
	/*
	 * Only the floor is here. The sidebar width and panel height that used to
	 * sit beside it were never read by any rule — `DEFAULT_LAYOUT` in
	 * `WorkbenchLayout.tsx` holds the sizes, because geometry is state the user
	 * drags and persists, not a token. The floor stays because CSS enforces it
	 * too, in the max-width rules that keep a region from eating the center.
	 */
	--ide-region-min: 170px;
}
